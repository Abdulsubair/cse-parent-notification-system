# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_here

# Android SMS Gateway (free — uses Android phone SIM)
# App: https://play.google.com/store/apps/details?id=me.capcom.smsgateway
ANDROID_SMS_GATEWAY_URL=http://<phone-local-ip>:8080
ANDROID_SMS_GATEWAY_USER=admin
ANDROID_SMS_GATEWAY_PASS=admin
